      "keys": {
        "مع": 187,
        "الجهاز": 201
      }
    },
    {
      "id": "P05",
      "text": "عندك ديمارور للبطارية",
      "startFrame": 219,
      "endFrame": 266,
      "keys": {
        "ديمارور": 228,
        "للبطارية": 243
      }
    },
    {
      "id": "P06",
      "text": "وگونفلور للرويضات",
