# Retell API key (the key with the "webhook" badge in the Retell dashboard).
# Used server side to call the Retell API AND to verify the x-retell-signature
# header on tool calls and webhooks (Retell signs with the API key; there is
# no separate webhook secret).
RETELL_API_KEY=

# Agent id created by scripts/provision-retell.ts (Checkpoint 3); needed by
# /api/create-web-call on Vercel.
RETELL_AGENT_ID=

# Supabase project (Settings > API). Service role key stays server side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the Vercel deployment, no trailing slash
# (e.g. https://atlas-voyages-demo.vercel.app). Used to build tool URLs.
APP_BASE_URL=
