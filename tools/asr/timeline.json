{
 "source": "Whisper large-v3 word timestamps, clamped to ffmpeg silencedetect (-40 dB, 0.15 s) speech islands",
 "phrases": [
  {
   "start": 0.15,
   "end": 1.3,
   "text": "أخيب شعور هو"
  },
  {
   "start": 1.63,
   "end": 3.42,
   "text": "شي نهار تفيق معطّل على الخدمة،"
  },
  {
   "start": 3.83,
   "end": 5.34,
   "text": "وتجي باش تشعل الطوموبيل ديالك،"
  },
  {
   "start": 5.7,
   "end": 6.13,
   "text": "والو!"
  },
  {
   "start": 6.48,
   "end": 7.86,
   "text": "البطارية ما بغاتش تعاون."
  },
  {
   "start": 8.22,
   "end": 8.59,
   "text": "ودابا،"
  },
  {
   "start": 9.03,
   "end": 10.81,
   "text": "واش غادي تبقى تسنّى شي حدّ يجي يعاونك،"
  },
  {
   "start": 11.19,
   "end": 13.13,
   "text": "وتزيد عليها مصاريف ما كنتيش حاسب ليها؟"
  },
  {
   "start": 13.63,
   "end": 15.3,
   "text": "الوقاية خير من العلاج."
  },
  {
   "start": 15.53,
   "end": 16.81,
   "text": "وها علاش جبنا ليك الحل."
  },
  {
   "start": 17.13,
   "end": 18.77,
   "text": "مع هاد الجهاز اللي كيبان صغير،"
  },
  {
   "start": 19.01,
   "end": 21.5,
   "text": "غادي تستافد من أربع خدمات ف منتوج واحد."
  },
  {
   "start": 21.88,
   "end": 22.95,
   "text": "بوستر للبطارية،"
  },
  {
   "start": 23.2,
   "end": 24.36,
   "text": "منفاخ للرويدات،"
  },
  {
   "start": 24.6,
   "end": 25.77,
   "text": "باور بانك للطوارئ،"
  },
  {
   "start": 25.96,
   "end": 26.82,
   "text": "وحتى ضو LED"
  },
  {
   "start": 26.97,
   "end": 27.86,
   "text": "ينفعك ف الظلام."
  },
  {
   "start": 28.19,
   "end": 28.76,
   "text": "تخيّل"
  },
  {
   "start": 28.96,
   "end": 31.25,
   "text": "هاد شي كامل ف جهاز واحد عملي"
  },
  {
   "start": 31.4,
   "end": 33.05,
   "text": "وساهل تخليه معاك ف الطوموبيل"
  },
  {
   "start": 33.45,
   "end": 37.16,
   "text": "ما تخليش مشكل ف البطارية ولا العجلة مفشوشة يعطلك نهارك"
  },
  {
   "start": 37.53,
   "end": 38.73,
   "text": "طلبو دابا من ماشري"
  },
  {
   "start": 38.92,
   "end": 40.27,
   "text": "وجرّبو قبل ما تخلّص"
  }
 ],
